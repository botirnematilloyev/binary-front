{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",

    "strict": true,
    // Backendda `Role` 1-based qilingan edi, shunda Go'ning nol qiymati
    // YAROQSIZ rol bo'ladi. Bu yerdagi ekvivalenti: indeks bo'yicha
    // murojaat `T | undefined` qaytaradi, ya'ni bo'sh massivdan element
    // olish kompilyatsiyada ko'rinadi, ishga tushganda emas.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  }
}

# www.binary.uz uchun prod sozlamalari. Serverda `.env` ga nusxalanadi.
# Hammasi ochiq ma'lumot — NEXT_PUBLIC_* bundle'ga tushadi, sir yozilmaydi.

NEXT_PUBLIC_API_URL=https://api.binary.uz/api/v1
NEXT_PUBLIC_SITE_URL=https://www.binary.uz
# Bot username, @ siz. Bo'sh bo'lsa kod ichidagi standart nom ishlatiladi.
NEXT_PUBLIC_TELEGRAM_BOT=

# Ixtiyoriy: odatiy qiymatlari docker-compose.yml da.
# API_INTERNAL_URL=http://binary_api:8080/api/v1
# WWW_PORT=3002
# BACKEND_NETWORK=binary_default

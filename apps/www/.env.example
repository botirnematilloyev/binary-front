# Brauzer ko'radigan API manzili. `NEXT_PUBLIC_` prefiksi bilan boshlangan
# har qanday qiymat JS bundle'ga TUSHADI — bu yerga hech qachon sir yozilmaydi.
NEXT_PUBLIC_API_URL=https://api.binary.uz/api/v1

# Server tomonidan (SSR/ISR paytida) ishlatiladigan manzil. Prodda compose
# tarmog'i ichidagi servis nomi: TLS, CORS va tashqi tarmoq kerak emas,
# ya'ni tezroq. O'rnatilmasa NEXT_PUBLIC_API_URL ishlatiladi.
# API_INTERNAL_URL=http://api:8080/api/v1

# Kanonik manzil — metadata, sitemap va OG havolalari shundan quriladi.
NEXT_PUBLIC_SITE_URL=https://www.binary.uz
